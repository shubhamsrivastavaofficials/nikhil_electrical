# ---------------------------------------------------------
# New Nikhil Electrical — Environment Variables
# Copy this file to .env (local dev) and fill in real values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# ---------------------------------------------------------

# PostgreSQL connection string (Supabase, Neon, Railway, or any Postgres host)
# Example (Supabase pooled connection, recommended for serverless).
# Add ?sslmode=require&connect_timeout=10 for a reliable, fast-failing connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connect_timeout=10"

# Secret used to sign admin session JWTs — generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site URL (used for SEO metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL="https://newnikhilelectrical.com"

# Vercel Blob storage token for gallery/product image uploads in production.
# Create one at: Vercel Dashboard → Storage → Blob → Create Store
# Leave empty for local development — uploads fall back to /public/uploads
BLOB_READ_WRITE_TOKEN=""

# Used only once by `npm run db:seed` to create the first admin login.
# Change the password immediately after first login (see README).
SEED_ADMIN_EMAIL="admin@newnikhilelectrical.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"
